{
  "name": "pma",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run -c vitest.rls.config.ts",
    "e2e": "playwright test",
    "eval": "node --env-file-if-exists=.env.local --import tsx eval/run.ts",
    "seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "seed:snapshot": "node --env-file-if-exists=.env.local --import tsx scripts/seed-snapshot.ts",
    "slack:manifest": "node --env-file-if-exists=.env.local --import tsx scripts/slack-manifest.ts",
    "create-user": "node --env-file-if-exists=.env.local --import tsx scripts/create-user.ts",
    "cron:setup": "node --env-file-if-exists=.env.local --import tsx scripts/cron-setup.ts",
    "supabase:config-push": "node --env-file-if-exists=.env.local --import tsx scripts/supabase-config-push.ts",
    "embed:snapshot": "node --env-file-if-exists=.env.local --import tsx scripts/embed-snapshot.ts",
    "demo:audio": "node --import tsx scripts/demo/make-sample-audio.ts",
    "design:pack": "node --import tsx scripts/demo/pack-design.ts",
    "github:app": "node --env-file-if-exists=.env.local --import tsx scripts/github-app.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@babel/parser": "^7.29.9",
    "@base-ui/react": "^1.9.0",
    "@fontsource/inter": "^5.3.0",
    "@octokit/rest": "^22.0.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "diff": "^8.0.4",
    "lucide-react": "^1.57.0",
    "mailparser": "^3.9.39",
    "mammoth": "^1.13.0",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.5",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/types": "^7.29.8",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
