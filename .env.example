# Copy to .env.local and fill in. Only the first block is required to run the demo locally.

# --- Required: your Supabase project (Project Settings > API Keys > Legacy API keys) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# The database password you chose when creating the project. `supabase db push` reads it, so it never asks.
SUPABASE_DB_PASSWORD=
APP_URL=http://localhost:3000
# Sign in with GitHub: a GitHub OAuth App (github.com/settings/developers) whose callback URL is
# <NEXT_PUBLIC_SUPABASE_URL>/auth/v1/callback. `npm run supabase:config-push` sends these to your dev project.
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
# Your Supabase projects' refs. The maintenance scripts refuse the production one; config-push only targets dev.
PMA_DEV_SUPABASE_REF=
PMA_PROD_SUPABASE_REF=

# --- Claude: every company adds its own key in PMA. This one is only for the demo app, and is optional:
# the seeded demo browses without it. Leave it empty on a public deployment, or anyone could spend it.
ANTHROPIC_API_KEY=
# mock: mock-ups are drawn in-app on the built-in Celeste canvas (Claude edits the real frame). Leave empty to use
# GitHub Actions when a design repo + GITHUB_TOKEN are set, otherwise schematic frames with no Claude call.
DRAFT_BACKEND=mock
# off: quick wins and Explore issues wait for someone to take them on instead of drafting by themselves
AUTO_DRAFT=

# --- Optional: richer ingest ---
# Without it Claude matches feedback to issues and screens from full lists (fine for small projects).
# Keys made in MongoDB Atlas also need VOYAGE_API_URL=https://ai.mongodb.com/v1
VOYAGE_API_KEY=
VOYAGE_API_URL=
# Recordings (Add feedback > Recording). Without it only the bundled sample recordings are transcribed.
DEEPGRAM_API_KEY=
WIDGET_DAILY_CAP=200
# The widget key of the app that collects feedback about PMA itself (never a customer's); the in-app
# Feedback button shows only when set.
PMA_FEEDBACK_WIDGET_KEY=

# --- Optional: GitHub (docs/self-hosting.md) ---
# Fine-grained token on the demo's design canvas repo, for drafting through GitHub Actions.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
# The PMA GitHub App (Connect with GitHub, Build it, See it live). `npm run github:app` registers one and
# writes these for you.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
# Only for the design canvas repo the seed creates the demo app with, as owner/name.
SEED_REPO=

# --- Optional: Slack (docs/self-hosting.md). Leave empty locally so nothing posts to a real workspace. ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Shared invite link to the Slack workspace (Slack: workspace menu > Invite people > Copy invite link). Shown as
# Join Slack on the welcome page and sidebar.
SLACK_INVITE_URL=

# --- Optional: deployment ---
# Bearer token for /api/cron/process and /api/cron/daily. Any long random string (openssl rand -hex 32).
CRON_SECRET=
